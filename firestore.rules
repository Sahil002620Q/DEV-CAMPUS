rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────
    // Helper functions
    // ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == "super_admin";
    }

    function isCafeteriaAdmin() {
      return isSignedIn() && (userRole() == "cafeteria_admin" || userRole() == "super_admin");
    }

    function isLibraryAdmin() {
      return isSignedIn() && (userRole() == "library_admin" || userRole() == "super_admin");
    }

    function isAdmin() {
      return isSignedIn() && (userRole() == "admin" || userRole() == "super_admin");
    }

    // ────────────────────────────────────────────
    // User collection (singular)
    // ────────────────────────────────────────────
    match /user/{uid} {
      // Users can read their own doc; super_admin can read all
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());

      // Only super_admin can change the role field
      allow update: if isSignedIn() && (
        // Own user can update non-role fields
        (request.auth.uid == uid && !("role" in request.resource.data.diff(resource.data).affectedKeys()))
        ||
        // Super admin can update anything
        isSuperAdmin()
      );

      allow create: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    // ────────────────────────────────────────────
    // Admin roles audit log
    // ────────────────────────────────────────────
    match /admin_roles/{uid} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ────────────────────────────────────────────
    // Cafeteria menu
    // ────────────────────────────────────────────
    match /cafeteria_menu/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCafeteriaAdmin();
    }

    // ────────────────────────────────────────────
    // Library
    // ────────────────────────────────────────────
    match /library/{resourceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isLibraryAdmin();
    }

    // ────────────────────────────────────────────
    // Notices
    // ────────────────────────────────────────────
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ────────────────────────────────────────────
    // Anonymous Ask
    // ────────────────────────────────────────────
    match /anon_ask/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only the author or any admin can delete
      allow delete: if isAdmin();
      allow update: if isSignedIn();
    }

    // ────────────────────────────────────────────
    // Lost and Found
    // ────────────────────────────────────────────
    match /lost_found/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, create: if isSignedIn();
      }
    }
  }
}
